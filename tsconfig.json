{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/admin/src/*"],
      "@/components/*": ["apps/admin/src/components/*"],
      "@/pages/*": ["apps/admin/src/pages/*"],
      "@/hooks/*": ["apps/admin/src/hooks/*"],
      "@/types/*": ["apps/admin/src/types/*"],
      "@/utils/*": ["apps/admin/src/utils/*"],
      "@/config/*": ["apps/admin/src/config/*"],
      "@happy-baby/domain-product": ["libs/domain/product/src/index.ts"],
      "@happy-baby/domain-order": ["libs/domain/order/src/index.ts"],
      "@happy-baby/domain-user": ["libs/domain/user/src/index.ts"],
      "@happy-baby/domain-category": ["libs/domain/category/src/index.ts"],
      "@happy-baby/domain-shared": ["libs/domain/shared/src/index.ts"],
      "@happy-baby/application-product": [
        "libs/application/product/src/index.ts"
      ],
      "@happy-baby/application-order": ["libs/application/order/src/index.ts"],
      "@happy-baby/application-user": ["libs/application/user/src/index.ts"],
      "@happy-baby/application-category": [
        "libs/application/category/src/index.ts"
      ],
      "@happy-baby/infrastructure-graphql": [
        "libs/infrastructure/graphql/src/index.ts"
      ],
      "@happy-baby/infrastructure-storage": [
        "libs/infrastructure/storage/src/index.ts"
      ],
      "@happy-baby/infrastructure-monitoring": [
        "libs/infrastructure/monitoring/src/index.ts"
      ],
      "@happy-baby/shared-utils": ["libs/shared/utils/src/index.ts"],
      "@happy-baby/shared-ui": ["libs/shared/ui/src/index.ts"],
      "@happy-baby/shared-stores": ["libs/shared/stores/src/index.ts"],
      "@happy-baby/shared-hooks": ["libs/shared/hooks/src/index.ts"],
      "@happy-baby/feature-products": ["libs/features/products/src/index.ts"],
      "@happy-baby/feature-categories": [
        "libs/features/categories/src/index.ts"
      ],
      "@happy-baby/feature-users": ["libs/features/users/src/index.ts"],
      "@happy-baby/feature-orders": ["libs/features/orders/src/index.ts"],
      "@happy-baby/feature-auth": ["libs/features/auth/src/index.ts"]
    }
  },
  "include": ["apps/admin/src/**/*", "libs/**/*.ts", "libs/**/*.tsx"],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
