{
  "name": "happy-baby-style-admin-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "nx run admin:dev",
    "dev:staging": "nx run admin:dev --configuration=staging",
    "build": "nx run admin:build",
    "build:staging": "nx run admin:build:staging",
    "build:dev": "nx run admin:build:development",
    "preview": "nx run admin:preview",
    "type-check": "nx run admin:type-check",
    "lint": "nx run admin:lint",
    "lint:fix": "nx run admin:lint --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"libs/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"libs/**/*.{ts,tsx}\"",
    "test": "nx run admin:test",
    "test:watch": "nx run admin:test --watch",
    "test:coverage": "nx run admin:test --coverage",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:check": "graphql-codegen --config codegen.yml && git diff --exit-code apps/admin/src/generated/graphql.ts || (echo '\\nERROR: apps/admin/src/generated/graphql.ts is out of sync. Run pnpm codegen and commit the result.' && exit 1)",
    "graphql:download-schema": "rover graph introspect http://localhost:3001/graphql --output apps/admin/src/graphql/schema.graphql",
    "graphql:generate": "pnpm graphql:download-schema && pnpm codegen",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/client": "^3.13.9",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react": "^10.55.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "apollo-upload-client": "^17.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphql": "^16.8.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.30.3",
    "shadcn": "^4.8.2",
    "styled-components": "^6.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@apollo/rover": "^0.35.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@nx/eslint": "^22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/jest": "^22.7.5",
    "@nx/react": "^22.7.5",
    "@nx/vite": "^22.7.5",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/apollo-upload-client": "^17.0.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "msw": "^2.14.6",
    "nx": "22.7.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  },
  "nx": {}
}
