# Copy this file to .env.development / .env.staging / .env.production and fill in values.
# All VITE_* vars are embedded into the client bundle at build time — never put secrets here.

VITE_MODE=development
VITE_GRAPHQL_URL=http://localhost:3001/graphql
VITE_APP_NAME=Happy Baby Style Admin
VITE_GRAPHQL_PLAYGROUND_ENABLED=false
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_SOURCE_MAPS=false
VITE_ENABLE_HOT_RELOAD=true
VITE_LOG_LEVEL=warn
VITE_PORT=3000
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_AUTH_TOKEN_EXPIRY=3600000
VITE_REFRESH_TOKEN_EXPIRY=604800000
